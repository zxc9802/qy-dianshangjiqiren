DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ecommerce_ai
JWT_SECRET=change-me
# Optional dedicated HMAC key for recharge-code storage. Use a separate 32+ byte random value in production.
# When empty, JWT_SECRET is used for backwards-compatible deployment.
RECHARGE_CODE_PEPPER=
EXTERNAL_REGISTRATION_ENABLED=true

# 涓荤珯鑷韩鍦板潃
MAIN_APP_URL=https://www.qycm.top

# 澶栭儴宸ヤ綔鍙?/ 瀛愮珯
VIDEO_APP_URL_SEEDANCE=https://disanfang.qyaijingxuan.top
KB_CHAT_APP_URL=https://qyzsk.qyaijingxuan.top
DETAIL_IMAGE_AGENT_APP_URL=https://dianpu.qyaijingxuan.top
BUYER_SHOW_APP_URL=https://maijiaxiu.qyaijingxuan.top
COPYWRITING_AGENT_APP_URL=https://wenan.qyaijingxuan.top

# 涓荤珯涓庡瓙绔欏叡浜殑 SSO 浜ゆ崲瀵嗛挜锛堝鏋滀綘鐨勮棰戝瓙绔欒繕鍦ㄧ敤锛?
VIDEO_SSO_INTERNAL_SECRET=change-me
USAGE_MONITOR_INTERNAL_SECRET=change-me
USAGE_MONITOR_USD_CNY_RATE=7.3
YUNWU_OPENAI_CHAT_GROUP_MULTIPLIER=1
YUNWU_OPENAI_CHAT_API_KEY=
YUNWU_OPENAI_CHAT_URL=https://api.openlux.ai/chat/completions
YUNWU_OPENAI_CHAT_MODEL=gpt-5.6-luna

# Per-product server-to-server secrets for external application SSO.
# Generate five distinct values and copy only the matching value to its target app.
SSO_XHSTW_CLIENT_SECRET=change-me
SSO_XIAOSHOU_CLIENT_SECRET=change-me
SSO_SABC_CLIENT_SECRET=change-me
SSO_BAOKUANGAIXIE_CLIENT_SECRET=change-me
SSO_CHANPINSHEJI_CLIENT_SECRET=change-me

# 鑱旂綉鎼滅储锛圓nySearch锛?
ANYSEARCH_API_KEY=as_sk_xxx
ANYSEARCH_API_URL=https://api.anysearch.com/v1/search

# 鍙€夛細admin 鍒濆鍖?
ADMIN_ACCOUNT=
ADMIN_PASSWORD=
ADMIN_NICKNAME=

# Optional: long-term memory with PostgreSQL + pgvector.
# Requires frontend/prisma/user_memories.sql to be applied to DATABASE_URL.
MEMORY_ENABLED=false
MEMORY_WRITE_ENABLED=false
MEMORY_MAX_RESULTS=5
MEMORY_EMBEDDING_API_URL=https://yunwu.ai/v1/embeddings
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_API_KEY=
